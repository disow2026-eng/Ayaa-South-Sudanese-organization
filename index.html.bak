  <!-- ===== VIDEO TEASER ===== -->
  <section class="section section--alt">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;">
        <div>
          <span class="section-label">Watch His Story</span>
          <h2 class="section-title">See Why Simon Built a School With His Life Savings</h2>
          <div class="divider"></div>
          <p style="color: var(--dark-gray); line-height: 1.8; margin-bottom: 1.5rem;" class="">
            WaterStep — AYAA's Louisville partner — documented Simon Ottaviano's extraordinary journey:
            from fleeing civil war in South Sudan to serving in the U.S. Army,
            earning his MBA, and ultimately sacrificing his retirement to build a school named after his mother.
          </p>
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="about.html#video" class="btn btn--primary">Watch the Full Story</a>
            <a href="https://www.facebook.com/simon.ottaviano.50" target="_blank" rel="noopener" class="btn" style="background: #1877F2; color: white; border-color: #1877F2;">Follow on Facebook</a>
          </div>
        </div>
        <div style="border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); background: #000; aspect-ratio: 16/9; position: relative;">
          <iframe src="https://www.facebook.com/plugins/video.php?href=https%3A%2F%2Fwww.facebook.com%2FWaterStep%2Fvideos%2F572520868981967%2F&amp;show_text=false&amp;width=560&amp;height=315&amp;appId" style="position: absolute; inset: 0; width: 100%; height: 100%; border: none;" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PARTNER SECTION ===== -->
  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom: 2rem;">
        <span class="section-label">Our Partners</span>
        <h2 class="section-title">Working Together for South Sudan</h2>
        <div class="divider divider--center"></div>
      </div>
      <div class="partner-banner fade-up">
        <div class="partner-banner__icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg></div>
        <div>
          <div class="partner-banner__label">Official Partner</div>
          <h3 style="font-size: 1.4rem; margin-bottom: 0.5rem;" class="">WaterStep — Louisville, Kentucky</h3>
          <p style="margin: 0; font-size: 0.95rem; color: var(--dark-gray);" class="">
            WaterStep is a Louisville-based nonprofit bringing safe water technology to communities
            in need worldwide. Their partnership with AYAA is delivering clean water to Ayaa Senior
            Secondary School and the village of Magwi — where generations suffered from bilharzia
            disease caused by contaminated water from the River Ayii.
          </p>
        </div>
      </div>
    </div>
  </section>

